# ============================================================
# ai-workspace 環境変数テンプレート
# コピーして .env を作成する: cp .env.example .env
# .env は .gitignore 済み。機密情報はここにのみ書く。
# ============================================================

# --- ローカルLLM（MLX系 OpenAI互換サーバー） ---------------
# 例: mlx_lm.server --model <path> --port 8080
#     LM Studio のローカルサーバーでも可
LOCAL_LLM_BASE_URL=http://localhost:8080/v1
# サーバーが認証不要なら空のままでよい
LOCAL_LLM_API_KEY=

# デフォルトで使う内部モデル名（qwen-35b / gemma-31b など）
DEFAULT_MODEL=qwen-35b

# サーバー側に渡す実モデル名（サーバーのロード名に合わせて変更）
GEMMA_SERVED_NAME=gemma-3-27b-it-mlx
QWEN_SERVED_NAME=qwen3-32b-mlx
LLAMA70B_SERVED_NAME=llama-3.3-70b-mlx

# --- クラウドLLM フォールバック（任意・未設定なら stub） ----
# OpenAI互換プロキシ（LiteLLM 等）経由の URL を推奨
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
CLAUDE_SERVED_NAME=claude-sonnet-4-5
GEMINI_BASE_URL=
GEMINI_API_KEY=
GEMINI_SERVED_NAME=gemini-2.5-pro

# --- GitHub（任意・未設定なら stub） ------------------------
GITHUB_TOKEN=
# repo 指定を省略した時に使うデフォルトリポジトリ（owner/name）
GITHUB_DEFAULT_REPO=

# --- Obsidian（任意・未設定なら stub） ----------------------
# vault のローカルパス。Mac mini の vault を同期している場合はそのパス
OBSIDIAN_VAULT_PATH=
# vault 内の保存先フォルダ名
OBSIDIAN_NOTE_FOLDER=ai-workspace

# --- n8n（任意・未設定なら stub） ---------------------------
# Mac mini 上の n8n の webhook ベースURL
# 例: http://mac-mini.local:5678/webhook
N8N_WEBHOOK_BASE_URL=

# --- memory層 ------------------------------------------------
# 実行ログの保存先ディレクトリ
MEMORY_DIR=data/memory
