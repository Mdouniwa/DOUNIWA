# しゃべる絵本メーカー 対話サーバー設定
# このファイルを .env にコピーして値を埋める(server/.env は git 管理外)

# --- 必須: Gemini API 認証 ---
# 課金有効なGoogle CloudプロジェクトのGemini APIキー
# (課金有効プロジェクトのキーなら入力データは学習に使われない。キーは絶対にコミットしないこと)
GEMINI_API_KEY=your-api-key-here

# --- 任意: ポート(既定 8788。n8n=5678 / Dify=80,3000,5001 と衝突しない値にすること) ---
PORT=8788

# --- 任意: CORS許可オリジン(カンマ区切り)。未設定なら全許可(Tailscale閉域網前提) ---
# CORS_ORIGINS=https://douniwa.vercel.app

# --- 任意: モデル差し替え(改廃が速いためIDが変わったらここで更新) ---
# CHAT_MODEL=gemini-3.5-flash-lite
# STORY_MODEL=gemini-3.6-flash
# IMAGE_MODEL=gemini-3.1-flash-image
# TTS_MODEL=gemini-3.1-flash-tts-preview
# TTS_VOICE=Leda
